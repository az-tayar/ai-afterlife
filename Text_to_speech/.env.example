# Copy this file to ".env" (same folder) and paste your key after the "=".
# Get a key at https://elevenlabs.io -> Profile -> API Keys. The free plan works.
# Without a key the engine still runs, using the offline backup voice.
ELEVENLABS_API_KEY=

# Optional: force a mode for every run (auto | elevenlabs | offline)
# TTS_MODE=auto
